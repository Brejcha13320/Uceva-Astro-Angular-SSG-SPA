---
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout>
  <div class="container">
    <h1>Contacto institucional</h1>
    <p class="lead">Canales de atención para resolver inquietudes académicas y administrativas.</p>
    <div class="row g-4 mt-1">
      <div class="col-md-4">
        <article class="card h-100"><div class="card-body"><h2 class="card-title h4">Atención presencial</h2><p class="card-text">Visita las oficinas de atención estudiantil de lunes a viernes, de 8:00 a. m. a 5:00 p. m.</p></div></article>
      </div>
      <div class="col-md-4">
        <article class="card h-100"><div class="card-body"><h2 class="card-title h4">Correo institucional</h2><p class="card-text">Escribe a <a href="mailto:atencion@uceva.edu.co">atencion@uceva.edu.co</a> para solicitudes generales.</p></div></article>
      </div>
      <div class="col-md-4">
        <article class="card h-100"><div class="card-body"><h2 class="card-title h4">Ubicación</h2><p class="card-text">Unidad Central del Valle del Cauca, Tuluá, Valle del Cauca.</p></div></article>
      </div>
    </div>
  </div>
</MainLayout>
