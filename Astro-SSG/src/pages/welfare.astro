---
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout>
  <div class="container">
    <h1>Bienestar estudiantil</h1>
    <p class="lead">Programas para fortalecer el bienestar integral y la participación universitaria.</p>
    <div class="row g-4 mt-1">
      <div class="col-md-4">
        <article class="card h-100"><div class="card-body"><h2 class="card-title h4">Salud y orientación</h2><p class="card-text">Recibe acompañamiento psicológico, médico y orientación para tu bienestar.</p></div></article>
      </div>
      <div class="col-md-4">
        <article class="card h-100"><div class="card-body"><h2 class="card-title h4">Deporte y cultura</h2><p class="card-text">Participa en actividades deportivas, artísticas y recreativas durante el semestre.</p></div></article>
      </div>
      <div class="col-md-4">
        <article class="card h-100"><div class="card-body"><h2 class="card-title h4">Apoyo socioeconómico</h2><p class="card-text">Conoce convocatorias y apoyos que favorecen tu permanencia estudiantil.</p></div></article>
      </div>
    </div>
  </div>
</MainLayout>
